# Every input to the build. A change here is a new release (see README.md).
#
# The libraries match Debian trixie's ffmpeg package: x264/AAC encodes and HLS
# segments are byte-identical to it, and SVT-AV1 and LAME output differs only by
# compiler rounding (same size and quality). Bump them deliberately: a new
# SVT-AV1 or x264 changes what a given preset/CRF produces.

FFMPEG_VERSION=7.1.5
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz
FFMPEG_SHA256=de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f

# x264 has no release tarballs; a commit hash pins the source as tightly as a checksum.
X264_URL=https://code.videolan.org/videolan/x264.git
X264_COMMIT=31e19f92f00c7003fa115047ce50978bc98c3a0d

SVTAV1_URL=https://gitlab.com/AOMediaCodec/SVT-AV1.git
SVTAV1_COMMIT=6e69def4ec283fe0b71195671245c3b768bebdef # v2.3.0

DAV1D_VERSION=1.5.1
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.1/dav1d-1.5.1.tar.xz
DAV1D_SHA256=401813f1f89fa8fd4295805aa5284d9aed9bc7fc1fdbe554af4292f64cbabe21

LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
